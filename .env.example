# Copy to .env.local for development. In production, set these in Vercel.
STUDY_SESSION_SECRET=
# Leave unset locally to use .data/study.db
STUDY_DATABASE_URL=
STUDY_DATABASE_AUTH_TOKEN=
# Optional fallback logins: {"jason":"salt:hash"}
STUDY_USERS=
# First-run setup: with this set and no login yet, /login lets you create the account in the browser.
STUDY_SETUP_CODE=
